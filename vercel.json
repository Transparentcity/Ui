{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "transparentcity.com" }],
      "destination": "https://transparent.city/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.transparentcity.com" }],
      "destination": "https://transparent.city/$1",
      "permanent": true
    }
  ]
}
